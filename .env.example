# Copy to .env and change what you need. No secrets are required.
OCR_HOST=127.0.0.1
OCR_PORT=8091
OCR_MODEL_ID=iapp/OpenThai2.1-OCR-Text-20261118
OCR_MODEL_REVISION=7092cacf4561679ff9ed19de6821faeb9c96d894
# Cache root; snapshots/<source hash>/ contains the verified OCR 2.2.0 files.
OCR_MODEL_DIR=models/OpenThai2.1-OCR-Text-20261118
# Download the model (about 6.6 MB) into OCR_MODEL_DIR if it is missing
OCR_AUTO_DOWNLOAD=true
# auto | onnxruntime | openvino   (auto = openvino if installed, else onnxruntime)
OCR_BACKEND=auto
# Threads per inference (1 = iApp's advice for throughput; 2 for a single process)
OCR_THREADS=1
# true = load the model when the server starts
OCR_PRELOAD=true
OCR_MAX_FILE_MB=50
OCR_MAX_PAGES=100
OCR_PDF_DPI=200

# Docker Compose: host interface to publish (0.0.0.0 = accessible over LAN).
# This is independent of OCR_HOST, which is only used by scripts/run.sh.
OCR_BIND_IP=127.0.0.1
